# Copy this file to .env and fill in real values before running in production.

# Postgres connection string used by the app container / drizzle-kit.
# When running via docker-compose, "db" is the Postgres service name.
DATABASE_URL=postgres://browsersync:changeme@db:5432/browsersync

# Port the Express app listens on inside its container.
PORT=3000

# Secret used to sign JWT access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this immediately invalidates every existing access token (refresh
# tokens are unaffected since they're validated against the database, not signed).
JWT_SECRET=replace-this-with-a-long-random-value

# How long an access token is valid for. Short-lived by design; the extension
# transparently uses the refresh token to get a new one.
ACCESS_TOKEN_TTL=15m

# How long a refresh token (one per logged-in device) stays valid before the
# user has to log that device in again.
REFRESH_TOKEN_TTL_DAYS=90

# Whether POST /api/auth/register is allowed to create new accounts. Flip to
# "false" once everyone who needs an account has one, without touching code.
ALLOW_REGISTRATION=true

# Comma-separated list of origins allowed to call the API. Browser extensions
# call from a chrome-extension:// origin, which is exempt from CORS entirely
# in Chromium's fetch implementation, so this is mainly a safety net for any
# future web-based admin tooling. Leave as "*" if you don't run any.
CORS_ORIGIN=*

# Max size (bytes) accepted for a single encrypted sync blob. Keeps someone
# from uploading an unbounded payload. 5 MB comfortably covers even a very
# large bookmark tree or 90 days of history once JSON-encoded and encrypted.
MAX_BLOB_BYTES=5242880
