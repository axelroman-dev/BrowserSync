{
    "manifest_version": 3,
    "name": "__MSG_extName__",
    "version": "1.1.1",
    "description": "__MSG_extDescription__",
    "default_locale": "en",
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "permissions": ["bookmarks", "history", "storage", "alarms", "management", "scripting", "favicon"],
    "optional_host_permissions": ["http://*/*", "https://*/*"],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "minimum_chrome_version": "104",
    "web_accessible_resources": [
        { "resources": ["content/frame.html"], "matches": ["http://*/*", "https://*/*"] }
    ]
}
